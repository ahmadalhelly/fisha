+class SharedUser {
+  final String id;
+  final String name;
+  final int role; // 0: view, 1: control, 2: admin
+  final bool all;
+  final List<String> strips;
+
+  const SharedUser({
+    required this.id,
+    required this.name,
+    required this.role,
+    required this.all,
+    this.strips = const [],
+  });
+
+  factory SharedUser.fromJson(Map<String, dynamic> j) {
+    List<String> parseStrips(dynamic v) {
+      if (v is List) return v.map((e) => e.toString().toUpperCase()).toList();
+      if (v is String && v.isNotEmpty) {
+        return v.split(',').map((e) => e.trim().toUpperCase()).where((e) => e.isNotEmpty).toList();
+      }
+      return const [];
+    }
+
+    return SharedUser(
+      id: _s(j['id']),
+      name: _s(j['name']),
+      role: _i(j['role']),
+      all: j['all'] == true,
+      strips: parseStrips(j['strips']),
+    );
+  }
+
+  Map<String, dynamic> toJson() => {
+        'id': id,
+        'name': name,
+        'role': role,
+        'all': all,
+        'strips': strips,
+      };
+}
+
+class InviteeProfile {
+  String host;
+  int port;
+  String hubId;
+  String user;
+  String pass;
+  String sharedId;
+  String mode; // 'shared'
+
+  InviteeProfile({
+    required this.host,
+    required this.port,
+    required this.hubId,
+    required this.user,
+    required this.pass,
+    required this.sharedId,
+    this.mode = 'shared',
+  });
+
+  Map<String, dynamic> toJson() => {
+        'host': host,
+        'port': port,
+        'hubId': hubId,
+        'user': user,
+        'pass': pass,
+        'sharedId': sharedId,
+        'mode': mode,
+      };
+
+  factory InviteeProfile.fromJson(Map<String, dynamic> j) => InviteeProfile(
+        host: _s(j['host'] ?? j['h']),
+        port: _i(j['port'] ?? j['p'], 8883),
+        hubId: _s(j['hubId'] ?? j['hub']),
+        user: _s(j['user'] ?? j['u']),
+        pass: _s(j['pass'] ?? j['pw']),
+        sharedId: _s(j['sharedId'] ?? j['u'] ?? j['user']),
+        mode: _s(j['mode'], 'shared'),
+      );
+}
