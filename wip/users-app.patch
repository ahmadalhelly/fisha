+  Future<void> _startSharedMqtt() async {
+    final profile = _sharedProfile;
+    if (profile == null) return;
+    final clientId = 'shapp-${DateTime.now().millisecondsSinceEpoch % 1000000000}';
+    final c = MqttServerClient.withPort(profile.host, clientId, profile.port);
+    c.secure = true;
+    c.securityContext = SecurityContext.defaultContext;
+    c.keepAlivePeriod = 30;
+    c.autoReconnect = true;
+    c.logging(on: false);
+    c.setProtocolV311();
+    c.connectionMessage = MqttConnectMessage().withClientIdentifier(clientId).startClean();
+    c.onConnected = () {
+      mqttConnected = true;
+      hubOnline = true;
+      mode = ConnMode.cloud;
+      notifyListeners();
+      // On first connect, rotate password
+      if (!_sharedPassRotated) {
+        _sharedPassRotated = true;
+        _doPassRotate(c, profile);
+      }
+    };
+    c.onAutoReconnected = () {
+      mqttConnected = true;
+      hubOnline = true;
+      mode = ConnMode.cloud;
+      notifyListeners();
+    };
+    c.onDisconnected = () {
+      mqttConnected = false;
+      mode = ConnMode.offline;
+      notifyListeners();
+    };
+    _mqtt = c;
+    try {
+      await c.connect(profile.user, profile.pass);
+    } catch (_) {
+      mqttConnected = false;
+      try { c.disconnect(); } catch (_) {}
+      _mqtt = null;
+      mode = ConnMode.offline;
+      notifyListeners();
+      _mqttRetry = Timer(const Duration(seconds: 15), () {
+        if (_mqtt == null && _sharedProfile != null) _startSharedMqtt();
+      });
+      return;
+    }
+    final base = _sharedBase(profile.hubId, profile.sharedId);
+    _mqttSub = c.updates?.listen((msgs) {
+      for (final m in msgs) {
+        final payload = m.payload;
+        if (payload is! MqttPublishMessage) continue;
+        final text = utf8.decode(payload.payload.message.toList(), allowMalformed: true);
+        _onSharedMqtt(m.topic.toString(), text, base, profile.sharedId);
+      }
+    });
+    c.subscribe('$base/#', MqttQos.atLeastOnce);
+  }
+
+  void _onSharedMqtt(String topic, String text, String base, String userId) {
+    if (topic == '$base/state') {
+      _applySharedState(text);
+    } else if (topic == '$base/cmd/ack') {
+      try {
+        final j = jsonDecode(text) as Map<String, dynamic>;
+        final done = _acks.remove((j['id'] ?? '').toString());
+        if (done != null && !done.isCompleted) done.complete(j);
+      } catch (_) {}
+    }
+  }
+
+  void _applySharedState(String body) {
+    try {
+      final j = jsonDecode(body) as Map<String, dynamic>;
+      // Parse 'me' object for role/identity
+      final me = j['me'];
+      if (me is Map) {
+        _sharedMeId = (me['id'] ?? '').toString();
+        _sharedMeName = (me['name'] ?? '').toString();
+        _sharedMeRole = (me['role'] as num?)?.toInt() ?? _sharedMeRole;
+      }
+      final devs = j['devices'];
+      if (devs is List) {
+        final list = <Strip>[];
+        for (final d in devs) {
+          if (d is! Map<String, dynamic>) continue;
+          var s = Strip.fromJson(d);
+          final p = _pending[s.mac];
+          if (p != null && p.isNotEmpty) s = s.withOutletState(p);
+          list.add(s);
+        }
+        _strips = list;
+        for (final s in list) {
+          if (!_order.contains(s.mac)) _order.add(s.mac);
+        }
+      }
+      hubOnline = true;
+      lastUpdate = DateTime.now();
+      notifyListeners();
+    } catch (_) {}
+  }
+
+  Future<void> _doPassRotate(MqttServerClient c, InviteeProfile profile) async {
+    try {
+      final id = 'pr${DateTime.now().millisecondsSinceEpoch}';
+      final done = Completer<Map<String, dynamic>>();
+      _acks[id] = done;
+      final base = _sharedBase(profile.hubId, profile.sharedId);
+      final msg = <String, dynamic>{'id': id, 'path': '/api/pass_rotate'};
+      final b = MqttClientPayloadBuilder()..addUTF8String(jsonEncode(msg));
+      c.publishMessage('$base/cmd', MqttQos.atLeastOnce, b.payload!);
+      final j = await done.future.timeout(const Duration(seconds: 15), onTimeout: () => <String, dynamic>{});
+      _acks.remove(id);
+      if (j['ok'] == true && j['data'] is Map) {
+        final newPw = (j['data'] as Map)['pw']?.toString();
+        if (newPw != null && newPw.isNotEmpty) {
+          _sharedProfile = InviteeProfile(
+            host: profile.host,
+            port: profile.port,
+            hubId: profile.hubId,
+            user: profile.user,
+            pass: newPw,
+            sharedId: profile.sharedId,
+          );
+          await _prefs?.setString('shared_profile', jsonEncode(_sharedProfile!.toJson()));
+          // Reconnect with new password
+          try { c.disconnect(); } catch (_) {}
+          _mqtt = null;
+          await Future.delayed(const Duration(seconds: 2));
+          if (_sharedProfile != null) _startSharedMqtt();
+        }
+      }
+    } catch (_) {}
+  }
+
+  // ---------- shared MQTT command ----------
+  Future<CmdResult> _sharedCmd(String action, [Map<String, dynamic> body = const {}]) async {
+    final profile = _sharedProfile;
+    if (profile == null || _mqtt == null || !mqttConnected) {
+      return CmdResult(false, t('err_no_conn'));
+    }
+    try {
+      final id = 'a${DateTime.now().millisecondsSinceEpoch}${_seq++}';
+      final done = Completer<Map<String, dynamic>>();
+      _acks[id] = done;
+      final base = _sharedBase(profile.hubId, profile.sharedId);
+      final msg = <String, dynamic>{'id': id, 'path': '/api/$action', ...body};
+      final bl = MqttClientPayloadBuilder()..addUTF8String(jsonEncode(msg));
+      _mqtt!.publishMessage('$base/cmd', MqttQos.atLeastOnce, bl.payload!);
+      final j = await done.future.timeout(const Duration(seconds: 12), onTimeout: () => <String, dynamic>{});
+      _acks.remove(id);
+      if (j.isEmpty) return CmdResult(false, t('err_no_ack'));
+      final ok = j['ok'] == true;
+      final data = j['data'];
+      final err = (j['error'] ?? '').toString();
+      return CmdResult(ok, ok ? null : (err.isNotEmpty ? err : t('err_not_confirmed')),
+          data is Map<String, dynamic> ? data : null);
+    } catch (_) {
+      return CmdResult(false, t('err_failed'));
+    }
+  }
