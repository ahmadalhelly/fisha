+
+void saveEmqxCfg() {
+  Preferences sec;
+  sec.begin("sec", false);
+  sec.putString("ex_url", emqxUrl);
+  sec.putString("ex_key", emqxKey);
+  sec.putString("ex_sec", emqxSec);
+  sec.end();
+  emqxConfigured = emqxUrl.length() && emqxKey.length() && emqxSec.length();
+}
+
+void loadHubUsers() {
+  usersNvs.begin("users", false);
+  size_t sz = usersNvs.getBytesLength("list");
+  if (sz == sizeof(HubUser) * MAX_HUB_USERS) {
+    static HubUser tmp[MAX_HUB_USERS];
+    usersNvs.getBytes("list", tmp, sz);
+    hubUserCount = 0;
+    for (int i = 0; i < MAX_HUB_USERS; i++) {
+      if (tmp[i].id[0]) hubUsers[hubUserCount++] = tmp[i];
+    }
+  }
+  // keep usersNvs open for writes
+}
+
+void saveHubUsers() {
+  static HubUser buf[MAX_HUB_USERS];
+  memset(buf, 0, sizeof(buf));
+  for (int i = 0; i < hubUserCount; i++) buf[i] = hubUsers[i];
+  usersNvs.putBytes("list", buf, sizeof(buf));
+}
+
+int findHubUser(const char* id) {
+  for (int i = 0; i < hubUserCount; i++)
+    if (strcmp(hubUsers[i].id, id) == 0) return i;
+  return -1;
+}
+
+// Returns true if mac is in scope for this user
+bool userHasMac(const HubUser& u, const String& mac) {
+  if (u.all) return true;
+  for (int i = 0; i < u.nStrips && i < 6; i++)
+    if (mac.equalsIgnoreCase(u.strips[i])) return true;
+  return false;
+}
+
+// Generate random alphanumeric password of given length
+String randPass(int len) {
+  const char CHARS[] = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789";
+  String s;
+  s.reserve(len);
+  for (int i = 0; i < len; i++) s += CHARS[esp_random() % 62];
+  return s;
+}
+
+// base64url encode (no padding)
+String base64url(const String& in) {
+  static const char T[] = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_";
+  String out;
+  int i = 0;
+  int n = in.length();
+  while (i < n) {
+    uint32_t a = (uint8_t)in[i++];
+    uint32_t b = i < n ? (uint8_t)in[i++] : 0;
+    uint32_t c = i < n ? (uint8_t)in[i++] : 0;
+    uint32_t triple = (a << 16) | (b << 8) | c;
+    out += T[(triple >> 18) & 0x3F];
+    out += T[(triple >> 12) & 0x3F];
+    if (i - 2 < n || i - 1 < n + 1) out += T[(triple >> 6) & 0x3F];   // safe guard
+    if (i - 1 < n) out += T[triple & 0x3F];
+  }
+  return out;
+}
