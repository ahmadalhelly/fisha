+    if (!x.used) continue;
+    String tmac = String(x.mac); tmac.toUpperCase();
+    if (!userHasMac(u, tmac)) continue;
+    if (!first) j += ","; first = false;
+    long in = (int32_t)(x.at - now) / 1000;
+    j += "{\"tid\":" + String(x.id) + ",\"mac\":\"" + String(x.mac) + "\",\"outlet\":" + String(x.outlet) +
+         ",\"kind\":\"" + (x.kind == 1 ? "cycle" : (x.on ? "on" : "off")) + "\",\"in_s\":" + String(in < 0 ? 0 : in) + "}";
+  }
+  j += "],\"schedules\":[";
+  first = true;
+  for (int i = 0; i < schedCount; i++) {
+    String sm = String(scheds[i].mac); sm.toUpperCase();
+    if (!userHasMac(u, sm)) continue;
+    if (!first) j += ","; first = false;
+    j += schedJson(scheds[i]);
+  }
+  j += "],\"automations\":[";
+  first = true;
+  for (int i = 0; i < autoCount; i++) {
+    String am = String(autos[i].mac); am.toUpperCase();
+    if (!userHasMac(u, am)) continue;
+    if (!first) j += ","; first = false;
+    j += autoJson(autos[i]);
+  }
+  j += "],\"devices\":[";
+  first = true;
+  for (int i = 0; i < MAX_STRIPS; i++) {
+    if (!strips[i].used || !strips[i].identified) continue;
+    if (!userHasMac(u, strips[i].mac)) continue;
+    if (!first) j += ","; first = false;
+    j += stripJson(i);
+  }
+  j += "]}";
+  if (j.length() > 7900) {
+    Serial.printf("[users] user %s state oversize (%u bytes), skipping\n", u.id, j.length());
+    return "";
+  }
+  return j;
+}
