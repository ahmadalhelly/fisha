+  String j = "{\"hub\":\"" + hubId + "\",\"hub_fw\":\"" + FW_VERSION + "\"" +
+             ",\"me\":{\"id\":\"" + String(u.id) + "\",\"name\":\"" + jsonEsc(String(u.name)) + "\",\"role\":" + String(u.role) + "}" +
