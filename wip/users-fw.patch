+void loadEmqxCfg() {
+  Preferences sec;
+  sec.begin("sec", true);
+  emqxUrl = sec.getString("ex_url", "");
+  emqxKey = sec.getString("ex_key", "");
+  emqxSec = sec.getString("ex_sec", "");
+  sec.end();
+  emqxConfigured = emqxUrl.length() && emqxKey.length() && emqxSec.length();
